{
  "expo": {
    "name": "kad",
    "slug": "kad",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/kad-icon-v4.png",
    "scheme": "kad",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#7027E8",
        "foregroundImage": "./assets/images/kad-icon-v4.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/kad-icon-v4.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "O aplicativo acessa suas fotos para definir sua imagem de perfil."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/kad-logo-v4.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "./assets/images/kad-logo-v4.png",
            "backgroundColor": "#FFFFFF"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
