{
  "name": "kad",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "start:staging": "node --no-warnings ./scripts/run-environment.mjs staging app start",
    "start:production": "node --no-warnings ./scripts/run-environment.mjs production app start",
    "web:staging": "node --no-warnings ./scripts/run-environment.mjs staging app web",
    "web:production": "node --no-warnings ./scripts/run-environment.mjs production app web",
    "build:staging": "node --no-warnings ./scripts/run-environment.mjs staging app build",
    "build:production": "node --no-warnings ./scripts/run-environment.mjs production app build",
    "env:check:staging": "node --no-warnings ./scripts/run-environment.mjs staging app check",
    "env:check:production": "node --no-warnings ./scripts/run-environment.mjs production app check",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "site": "npm --prefix site run dev",
    "site:staging": "node --no-warnings ./scripts/run-environment.mjs staging site start",
    "site:production": "node --no-warnings ./scripts/run-environment.mjs production site start",
    "site:build": "npm --prefix site run build",
    "site:build:staging": "node --no-warnings ./scripts/run-environment.mjs staging site build",
    "site:build:production": "node --no-warnings ./scripts/run-environment.mjs production site build",
    "site:check": "npm --prefix site run check",
    "admin": "npm --prefix admin run dev",
    "admin:staging": "node --no-warnings ./scripts/run-environment.mjs staging admin start",
    "admin:production": "node --no-warnings ./scripts/run-environment.mjs production admin start",
    "admin:preview": "npm --prefix admin run dev:preview",
    "admin:build": "npm --prefix admin run build",
    "admin:build:staging": "node --no-warnings ./scripts/run-environment.mjs staging admin build",
    "admin:build:production": "node --no-warnings ./scripts/run-environment.mjs production admin build",
    "editorial:validate-package": "node --no-warnings --experimental-strip-types scripts/validate-editorial-package.ts",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "node --no-warnings --test tests/*.test.ts",
    "check": "npm run test && npm run typecheck && npm run lint"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@noble/ciphers": "^1.3.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/drawer": "^7.5.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@supabase/supabase-js": "^2.111.0",
    "expo": "~54.0.37",
    "expo-constants": "~18.0.14",
    "expo-crypto": "~15.0.8",
    "expo-dev-client": "~6.0.21",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-iap": "^5.4.1",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.11",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.1.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "standardwebhooks": "1.0.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
